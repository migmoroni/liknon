      "runtimeBaseline": "macOS 15 or newer; ad hoc signed and not notarized"
    },
    {
      "rustTarget": "aarch64-apple-darwin",
      "runner": "macos-15",
      "operatingSystem": "macos",
      "architecture": "aarch64",
      "archiveFormat": "tar-gz",
      "executableSuffix": "",
