[CmdletBinding()]
param(
    [string]$InstallDir = (Join-Path $env:LOCALAPPDATA "Liknon\bin"),
    [string]$BaseUrl = '@@BASE_URL@@',
    [switch]$Uninstall
)

$ErrorActionPreference = "Stop"
$Product = '@@PRODUCT@@'
$Package = '@@PACKAGE@@'
$Version = '@@VERSION@@'
$Tag = '@@TAG@@'
$Commit = '@@COMMIT@@'
$ReleasePrefix = '@@RELEASE_PREFIX@@'
$SigningKeyId = '@@SIGNING_KEY_ID@@'
$CanonicalCommand = '@@CANONICAL_COMMAND@@.exe'
$AliasCommand = '@@ALIAS_COMMAND@@.exe'
$PublicKeyPem = @'
@@PUBLIC_KEY_PEM@@
'@

if ($PSVersionTable.PSVersion.Major -lt 7) {
    throw "PowerShell 7 or newer is required for RSA manifest verification."
}
if ($BaseUrl -notmatch '^https://' -and $BaseUrl -notmatch '^http://(127\.0\.0\.1|localhost)(:\d+)?$') {
    throw "Download origin must use HTTPS (HTTP is accepted only for local verification)."
}
$BaseUrl = $BaseUrl.TrimEnd('/')

if ($Uninstall) {
    Remove-Item -LiteralPath (Join-Path $InstallDir $CanonicalCommand) -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath (Join-Path $InstallDir $AliasCommand) -Force -ErrorAction SilentlyContinue
    Write-Output "Removed $CanonicalCommand and $AliasCommand from $InstallDir"
    exit 0
}

if (-not $IsWindows -or [System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture -ne [System.Runtime.InteropServices.Architecture]::X64) {
    throw "This installer supports Windows x64 only."
}

$Target = "x86_64-pc-windows-msvc"
$ReleaseUrl = "$BaseUrl/$ReleasePrefix/v$Version"
$TempDir = Join-Path ([System.IO.Path]::GetTempPath()) ("liknon-install-" + [guid]::NewGuid())
New-Item -ItemType Directory -Path $TempDir | Out-Null

try {
    $ManifestPath = Join-Path $TempDir "manifest.json"
    $ManifestSignaturePath = Join-Path $TempDir "manifest.sig"
    Invoke-WebRequest -UseBasicParsing -MaximumRedirection 0 -Uri "$ReleaseUrl/manifest.json" -OutFile $ManifestPath
    Invoke-WebRequest -UseBasicParsing -MaximumRedirection 0 -Uri "$ReleaseUrl/manifest.sig" -OutFile $ManifestSignaturePath

    $Rsa = [System.Security.Cryptography.RSA]::Create()
    try {
        $Rsa.ImportFromPem($PublicKeyPem)
        $ManifestBytes = [System.IO.File]::ReadAllBytes($ManifestPath)
        $SignatureBytes = [System.IO.File]::ReadAllBytes($ManifestSignaturePath)
        $Verified = $Rsa.VerifyData(
            $ManifestBytes,
            $SignatureBytes,
            [System.Security.Cryptography.HashAlgorithmName]::SHA256,
            [System.Security.Cryptography.RSASignaturePadding]::Pkcs1
        )
    }
    finally {
        $Rsa.Dispose()
    }
    if (-not $Verified) {
        throw "Manifest signature is invalid for key $SigningKeyId."
    }

    $Manifest = Get-Content -LiteralPath $ManifestPath -Raw | ConvertFrom-Json
    if ($Manifest.schemaVersion -ne 1 -or
        $Manifest.identity.product -ne $Product -or
        $Manifest.identity.package -ne $Package -or
        $Manifest.identity.version -ne $Version -or
        $Manifest.identity.tag -ne $Tag -or
        $Manifest.identity.commit -ne $Commit) {
        throw "Manifest release identity mismatch."
    }

    $Artifacts = @($Manifest.artifacts | Where-Object { $_.target -eq $Target })
    if ($Artifacts.Count -ne 1) {
        throw "Manifest does not contain exactly one artifact for $Target."
    }
    $Artifact = $Artifacts[0]
    if ([System.IO.Path]::GetFileName($Artifact.archive.path) -ne $Artifact.archive.path) {
        throw "Manifest contains an unsafe archive path."
    }
    if ($Artifact.platformAuthenticity.mode -ne "self-signed-authenticode" -or
        -not $Artifact.platformAuthenticity.verified -or
        -not $Artifact.platformAuthenticity.timestamped -or
        [string]::IsNullOrWhiteSpace($Artifact.platformAuthenticity.certificateFingerprint)) {
        throw "Manifest contains incomplete Windows authenticity evidence."
    }
    $ExpectedFingerprint = $Artifact.platformAuthenticity.certificateFingerprint
    $ArchivePath = Join-Path $TempDir $Artifact.archive.path
    Invoke-WebRequest -UseBasicParsing -MaximumRedirection 0 -Uri "$ReleaseUrl/$($Artifact.archive.path)" -OutFile $ArchivePath
    $ArchiveHash = (Get-FileHash -Algorithm SHA256 -LiteralPath $ArchivePath).Hash.ToLowerInvariant()
    if ($ArchiveHash -ne $Artifact.archive.sha256) {
        throw "Archive hash mismatch."
    }

    $ExtractDir = Join-Path $TempDir "extracted"
    Expand-Archive -LiteralPath $ArchivePath -DestinationPath $ExtractDir
    foreach ($CommandName in @($CanonicalCommand, $AliasCommand)) {
        $Records = @($Artifact.commands | Where-Object { $_.name -eq $CommandName })
        if ($Records.Count -ne 1) {
            throw "Manifest command record is missing: $CommandName"
        }
        $CommandPath = Join-Path $ExtractDir $CommandName
        if (-not (Test-Path -LiteralPath $CommandPath -PathType Leaf)) {
            throw "Archive command is missing: $CommandName"
        }
        $CommandHash = (Get-FileHash -Algorithm SHA256 -LiteralPath $CommandPath).Hash.ToLowerInvariant()
        if ($CommandHash -ne $Records[0].sha256) {
            throw "Extracted command hash mismatch: $CommandName"
        }
        $NativeSignature = Get-AuthenticodeSignature -LiteralPath $CommandPath
        if ($NativeSignature.Status -eq "NotSigned" -or
            $NativeSignature.Status -eq "HashMismatch" -or
            $NativeSignature.SignerCertificate.Thumbprint -ne $ExpectedFingerprint -or
            $null -eq $NativeSignature.TimeStamperCertificate) {
            throw "Native signature evidence mismatch: $CommandName"
        }
    }

    New-Item -ItemType Directory -Path $InstallDir -Force | Out-Null
    $Token = [guid]::NewGuid().ToString("N")
    $CanonicalDestination = Join-Path $InstallDir $CanonicalCommand
    $AliasDestination = Join-Path $InstallDir $AliasCommand
    $CanonicalNew = Join-Path $InstallDir ".$CanonicalCommand.new.$Token"
    $AliasNew = Join-Path $InstallDir ".$AliasCommand.new.$Token"
    $CanonicalBackup = Join-Path $InstallDir ".$CanonicalCommand.backup.$Token"
    $AliasBackup = Join-Path $InstallDir ".$AliasCommand.backup.$Token"
    Copy-Item -LiteralPath (Join-Path $ExtractDir $CanonicalCommand) -Destination $CanonicalNew
    Copy-Item -LiteralPath (Join-Path $ExtractDir $AliasCommand) -Destination $AliasNew

    $HadCanonical = Test-Path -LiteralPath $CanonicalDestination
    $HadAlias = Test-Path -LiteralPath $AliasDestination
    try {
        if ($HadCanonical) { Move-Item -LiteralPath $CanonicalDestination -Destination $CanonicalBackup }
        if ($HadAlias) { Move-Item -LiteralPath $AliasDestination -Destination $AliasBackup }
        Move-Item -LiteralPath $CanonicalNew -Destination $CanonicalDestination
        Move-Item -LiteralPath $AliasNew -Destination $AliasDestination
        Remove-Item -LiteralPath $CanonicalBackup, $AliasBackup -Force -ErrorAction SilentlyContinue
    }
    catch {
        Remove-Item -LiteralPath $CanonicalDestination, $AliasDestination -Force -ErrorAction SilentlyContinue
        if ($HadCanonical -and (Test-Path -LiteralPath $CanonicalBackup)) {
            Move-Item -LiteralPath $CanonicalBackup -Destination $CanonicalDestination
        }
        if ($HadAlias -and (Test-Path -LiteralPath $AliasBackup)) {
            Move-Item -LiteralPath $AliasBackup -Destination $AliasDestination
        }
        throw "Transactional installation failed; previous commands were restored. $($_.Exception.Message)"
    }

    Write-Output "Installed $CanonicalCommand and $AliasCommand $Version in $InstallDir"
}
finally {
    Remove-Item -LiteralPath $TempDir -Recurse -Force -ErrorAction SilentlyContinue
}
