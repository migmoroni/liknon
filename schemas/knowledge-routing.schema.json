{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/migmoroni/workspace-validator/schemas/knowledge-routing.schema.json",
  "title": "Workspace Validator Knowledge Routing Fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "cases"],
  "properties": {
    "$schema": { "const": "../../schemas/knowledge-routing.schema.json" },
    "schemaVersion": { "const": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "documentIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" } },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "workspaceFacts", "networkAccess", "expectedDocumentIds", "rejectedDocumentIds", "expectedBehavior"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "$ref": "#/$defs/nonEmpty" },
        "workspaceFacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "networkAccess": { "enum": ["unavailable", "available-if-authorized"] },
        "expectedDocumentIds": { "$ref": "#/$defs/documentIds" },
        "rejectedDocumentIds": { "$ref": "#/$defs/documentIds" },
        "expectedBehavior": {
          "enum": [
            "route-exact-local-guidance",
            "compose-smallest-relevant-set",
            "report-missing-local-coverage",
            "remain-useful-and-report-unavailable-depth",
            "explain-overlap-and-distinct-blind-spots",
            "preserve-native-standard-terminology",
            "route-javascript-typescript-local-guidance"
          ]
        }
      }
    }
  }
}
