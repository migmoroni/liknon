{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/migmoroni/liknon/schemas/knowledge-rubric.schema.json",
  "title": "Liknon Shared-Knowledge Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "rubricId", "scale", "criteria"],
  "properties": {
    "$schema": { "const": "../../schemas/knowledge-rubric.schema.json" },
    "schemaVersion": { "const": 1 },
    "rubricId": { "$ref": "#/$defs/id" },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2"],
      "properties": {
        "0": { "$ref": "#/$defs/nonEmpty" },
        "1": { "$ref": "#/$defs/nonEmpty" },
        "2": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "failureExample"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "$ref": "#/$defs/nonEmpty" },
        "failureExample": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
